# Mash DataSub - GitHub-safe environment template
# Copy to your hosting provider's Environment Variables.
# NEVER commit real secrets or passwords.

NODE_ENV=production
APP_URL=

# Authentication / owner setup
JWT_SECRET=
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=
OWNER_INITIAL_TRANSACTION_PIN=

# Payment gateway selection
PAYMENT_PROVIDER=PAYSTACK
PAYMENT_BACKUP_PROVIDER=NONE
PAYMENT_ENVIRONMENT=test

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# RapidBills VTU
VTU_PROVIDER_API_KEY=
VTU_PROVIDER_USER_ID=
VTU_PROVIDER_URL=https://www.rapidbills.ng/api/reseller/v1

# Optional Monnify
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://api.monnify.com

# Optional Squad
SQUAD_API_KEY=
SQUAD_PUBLIC_KEY=
SQUAD_SECRET_KEY=
SQUAD_MERCHANT_ID=
SQUAD_BASE_URL=https://api.squadco.com

# Optional Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_CALLBACK_URL=

# Email / Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Other runtime options
ALLOW_DEV_OTP=false
DISABLE_HMR=false
